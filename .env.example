# =============================================================================
# MAITRI Health System — Environment Configuration Template
# =============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
#
# NOTE: All defaults are pre-configured for local offline development.
# Do NOT commit production credentials or secrets to version control.
# =============================================================================

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./maitri.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Machine Learning & Inference Settings
MODEL_A_PATH=models/saved/model_a.pkl
MODEL_D_ONNX_PATH=models/saved/model_d_triage.onnx
PROTOCOL_DOC_PATH=protocols/antenatal_protocol_excerpts.md

# Frontend Configuration
VITE_API_URL=http://localhost:8000
